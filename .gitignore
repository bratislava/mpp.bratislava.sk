# Conductor workspace context
.context/

# env files: nothing at the repo root is meant to be committed. Per-service rules live in
# backend/.gitignore and frontend/.gitignore, which allow their .env.deploy.* / .env.build.*.
.env*
!.env.example
.env*.local

# OS
.DS_Store

# IDEs and editors
.idea/
.vscode/

# Local agent settings
.claude/settings.local.json

# Track the gstack team-mode shim (settings + hook), not the skill tree —
# each dev installs gstack globally via `./setup --team`
!.claude
!.claude/settings.json
!.claude/hooks/
.claude/skills/
