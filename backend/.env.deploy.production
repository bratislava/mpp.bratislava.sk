# Read at deploy time by the infra repo (terraform-modules/github_env_file) at the commit the
# deployed image was built from, and merged into the mpp-backend-env ConfigMap. Non-secret
# values only: this repo is public. See backend/README.md for the full contract.
#
# NODE_ENV is production in every cluster, including production: it selects the runtime
# mode, not the environment. PORT and DATABASE_URL are Terraform's, not ours.

NODE_ENV=production
