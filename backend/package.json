{
  "name": "mpp-backend",
  "version": "0.0.1",
  "description": "NestJS MPP Backend",
  "author": "Bratislava Innovations",
  "private": true,
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=12.0.2 <13"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:migrate:prod": "prisma migrate deploy && npm run start:prod",
    "start:dbpush:debug": "prisma db push && npm run start:debug",
    "lint": "tsc && eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "16.6.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@bratislava/eslint-config-nest": "0.7.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "multer": "2.3.0",
    "eslint-plugin-sonarjs": {
      "minimatch": "9.0.9"
    },
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  }
}
